# Normalise line endings in the repository so a Windows checkout and any other
# platform agree on what the files contain.
* text=auto

# Windows-only scripts and manifests: keep CRLF in the working tree, since
# PowerShell and Task Scheduler on Windows are the only consumers.
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Snapshots are data, never diffed.
*.json text eol=lf
